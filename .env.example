# ---------------------------------------------------------------------------
# X AUTO 環境変数サンプル
# このファイルを .env にコピーして値を埋めてください。
# ---------------------------------------------------------------------------

# --- データベース ---------------------------------------------------------
# ローカル PostgreSQL の例。Supabase へ移行する場合はこの1行を差し替えるだけ。
DATABASE_URL="postgresql://xauto:xauto_dev@127.0.0.1:5432/xauto?schema=public"

# --- 認証 (Auth.js) -------------------------------------------------------
# 本番では必ず自分で生成した値に置き換えること: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-base64-string"
# 本番URL (Vercel等では自動設定されるため通常は不要)
# AUTH_URL="https://example.com"

# --- 外部APIの動作モード --------------------------------------------------
# mock: 認証情報なしでフィクスチャデータを使う (開発の既定)
# real: 実際の X API / Anthropic API を呼び出す
X_API_MODE="mock"
AI_MODE="mock"

# --- X API (X_API_MODE=real のときのみ必要) -------------------------------
# https://developer.x.com/ で従量課金プランを取得し、OAuth 2.0 アプリを作成する
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# アプリ単位の読み取りに使う Bearer トークン
X_BEARER_TOKEN=""
# X OAuth 2.0 PKCE のコールバックURL (X側のアプリ設定と一致させること)
X_OAUTH_REDIRECT_URI="http://localhost:3000/api/x/callback"

# --- Anthropic API (AI_MODE=real のときのみ必要) --------------------------
ANTHROPIC_API_KEY=""
# 分析・生成に使うモデル
ANTHROPIC_MODEL="claude-sonnet-5"

# --- 暗号化 ---------------------------------------------------------------
# X の OAuth トークンを DB に保存する際の暗号化キー (32バイトのbase64)
# 生成: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="change-me-to-a-random-32-byte-base64-string"

# --- コスト制御 (F-25) ----------------------------------------------------
# 新規ユーザーに適用される既定値。UIの設定画面から変更できる。
DEFAULT_MONTHLY_BUDGET_USD="30"
DEFAULT_BUDGET_WARNING_RATIO="0.8"
# X API の投稿取得キャッシュ有効期間 (時間)
POST_CACHE_TTL_HOURS="24"
